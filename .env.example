# Copy this file to .env and fill in your own values.
# These are YOUR Google Cloud OAuth credentials — this project ships with
# none, and cannot use anyone else's. See README.md for how to create them
# (takes about 5 minutes, no cost).

GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=

# Transcript language policy (all optional — unset = always the video's
# native language). If the native language is in the allowed list it is
# fetched; otherwise the preferred language; otherwise the first available
# allowed track. Languages use YouTube codes (de, en, fr, zh-Hant, pt-BR).
#
# Example: only load German and English; fall back to English for videos in
# any other language:
# YT_TRANSCRIPT_LANGUAGES=de,en
# YT_TRANSCRIPT_LANGUAGE_PREFERRED=en

# AI summary (optional — only needed for the `summarize` command). Summaries
# are generated by the `pi` coding-agent CLI, one ephemeral --no-session
# process per video (no state shared between summaries). pi owns provider/
# model/auth; these only tune the invocation.
# YT_SUMMARY_PI_BIN=pi
# YT_SUMMARY_PI_MODEL=            # pi --model pattern; empty = pi's default
# YT_SUMMARY_LANGUAGE=de          # de/en/...; empty = YT_TRANSCRIPT_LANGUAGE_PREFERRED, else de
# YT_SUMMARY_MAX_CHARS=24000      # transcript truncation ceiling
# YT_SUMMARY_TIMEOUT_S=300        # wall-clock cap per pi call
# YT_SUMMARY_RETRIES=2
# YT_SUMMARY_THROTTLE_S=0         # pause between calls

# Copy this file to .env and fill in your own values.
# These are YOUR Google Cloud OAuth credentials — this project ships with
# none, and cannot use anyone else's. See README.md for how to create them
# (takes about 5 minutes, no cost).

GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=

# Transcript language policy (all optional — unset = always the video's
# native language). If the native language is in the allowed list it is
# fetched; otherwise the preferred language; otherwise the first available
# allowed track. Languages use YouTube codes (de, en, fr, zh-Hant, pt-BR).
#
# Example: only load German and English; fall back to English for videos in
# any other language:
# YT_TRANSCRIPT_LANGUAGES=de,en
# YT_TRANSCRIPT_LANGUAGE_PREFERRED=en

# Shorts policy for `fetch` (optional). Set to true to globally skip Shorts
# (videos the API reports with duration PT0S). Per-run overrides:
#   fetch --no-shorts  -> skip even if this is unset/false
#   fetch --shorts     -> include even if this is true
# YT_FETCH_NO_SHORTS=false

# Speech-to-text fallback (optional — only needed for the `stt` command,
# which transcribes videos WITHOUT a caption track via Whisper).
# Endpoint must be OpenAI-compatible (/audio/transcriptions), e.g.
# https://ai.ascas.de/api/v1 (proxied) or http://as-ai02:PORT/v1 (direct).
# YT_STT_BASE_URL=
# YT_STT_API_KEY=
*** YT_STT_MODEL=Whisper-Large-v3-Turbo
# YT_STT_LANGUAGE=de          # empty = auto-detect
# YT_STT_TIMEOUT_S=600        # per chunk upload
# YT_STT_CHUNK_S=600          # audio chunk size in seconds per request
# YT_STT_VAD=true             # local Silero VAD: cut silence before upload
                              # (needs requirements-stt.txt + model below)
# YT_STT_VAD_MODEL=/path/to/silero_vad.onnx
# YT_STT_YTDLP_BIN=yt-dlp     # path to yt-dlp if not on PATH

# AI summary (optional — only needed for the `summarize` command). Summaries
# are generated by the `pi` coding-agent CLI, one ephemeral --no-session
# process per video (no state shared between summaries). pi owns provider/
# model/auth; these only tune the invocation.
# YT_SUMMARY_PI_BIN=pi
# YT_SUMMARY_PI_MODEL=            # pi --model pattern; empty = pi's default
# YT_SUMMARY_LANGUAGE=de          # de/en/...; empty = YT_TRANSCRIPT_LANGUAGE_PREFERRED, else de
# YT_SUMMARY_MAX_CHARS=24000      # transcript truncation ceiling
# YT_SUMMARY_TIMEOUT_S=300        # wall-clock cap per pi call
# YT_SUMMARY_RETRIES=2
# YT_SUMMARY_THROTTLE_S=0         # pause between calls

# Transcript paragraphing (new fetches only): a pause of >= this many seconds
# between caption snippets becomes a paragraph break. Verbatim, no LLM.
# YT_PARAGRAPH_GAP_S=1.0

# Transcript reformat (optional — only needed for the `reformat` command).
# Inserts paragraphs + ### headings into the transcript on the wiki source
# pages (raw/ stays verbatim). Same pi mechanics as summarize; defaults for
# PI_BIN/PI_MODEL fall back to the YT_SUMMARY_* values.
# YT_REFORMAT_PI_BIN=
# YT_REFORMAT_PI_MODEL=
# YT_REFORMAT_MAX_CHARS=120000    # longer transcripts marked too_long, never truncated
# YT_REFORMAT_TIMEOUT_S=300
# YT_REFORMAT_RETRIES=2
# YT_REFORMAT_THROTTLE_S=0
